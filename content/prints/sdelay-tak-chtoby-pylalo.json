  "story": {
    "eyebrow": "разбор",
    "heading": "От намерения к действию",
    "spec_title": "Спецификация",
    "spec": [
      [
        "Формула",
        "FAC UT ARDEAT"
      ],
      [
        "Перевод",
        "сделай так, чтобы пылало"
      ],
      [
